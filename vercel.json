{
  "version": 2,
  "name": "xmqa-online",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/online", "destination": "/" },
    { "source": "/online/:path*", "destination": "/:path*" },
    { "source": "/arkbase", "destination": "/arkbase/index.html" }
  ],
  "redirects": [
    { "source": "/freebase", "destination": "/arkbase/", "permanent": true },
    { "source": "/freebase/:path*", "destination": "/arkbase/", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
    ]},
    { "source": "/((?!arkbase).*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests" }
    ]},
    { "source": "/api/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
  ]
}
